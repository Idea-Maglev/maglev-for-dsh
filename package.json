{
  "name": "@idea-maglev/maglev-for-dsh",
  "version": "0.1.3",
  "description": "Maglev for DSH: 面向 DeepSeek Harness 的研发对齐插件（29 技能 + spec 工具 + 结晶事件 + Maglev GUI）",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "cordis.patch.yml",
    ".agents/",
    "assets/",
    "scripts/",
    "src/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "author": "feiyu.gao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Idea-Maglev/maglev-for-dsh.git"
  },
  "homepage": "https://github.com/Idea-Maglev/maglev-for-dsh",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2"
  }
}